          "bgm": 27,
          "sfx": null,
          "characters": [],
          "flash": false,
          "flashDuration": 400,
          "shake": false,
          "shakeType": "shake-horizontal",
          "shakeDuration": 300
        },
        {
          "speaker": "center",
          "name": "",
          "identity": "",
          "text": "(ที่โต๊ะอาหารประจำรถ Heathcliff กำลังนั่งจ้องสมุดโน้ตปกหนังสีน้ำตาลเข้ม คิ้วขมวดควงเป็นปม มือถือปากกาเกร็งจนแทบหัก)",
          "bg": 6,
          "bgm": null,
          "sfx": null,
          "characters": [],
          "flash": false,
          "flashDuration": 400,
          "shake": false,
          "shakeType": "shake-horizontal",
          "shakeDuration": 300
        },
        {
          "speaker": "center",
          "name": "Heathcliff",
          "identity": "",
          "text": "โธ่เว้ย! คำภาษาอังกฤษพวกนี้มันจะใช้ยากอะไรขนาดนี้ฟะ!",
          "bg": 6,
